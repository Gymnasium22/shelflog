# Public Supabase credentials (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical app URL (production domain or GitHub Pages)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only (never expose in client bundles)
SUPABASE_SERVICE_ROLE_KEY=

# Telegram Mini App bot token (server-side initData validation)
TELEGRAM_BOT_TOKEN=
